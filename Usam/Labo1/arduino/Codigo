#include "Arduino.h" #define bot1 ((PINB >> PB2) & 1) #define bot2 ((PINB >> PB3) & 1) #define bot3 ((PINB >> PB4) & 1) #define bot4 ((PINB >> PB5) & 1) int main(void) { DDRD |= (1 << PD2) | (1 << PD3) | (1 << PD4) | (1 << PD5) | (1 << PD6) | (1 << PD7); DDRB |= (1 << PB0) | (1 << PB1); DDRB &= ~(1 << PB2); PORTB |= (1 << PB2); DDRB &= ~(1 << PB3); PORTB |= (1 << PB3); DDRB &= ~(1 << PB4); PORTB |= (1 << PB4); DDRB &= ~(1 << PB5); PORTB |= (1 << PB5); bool contador = 0, bot1_prev = 1; uint8_t velocidad = 150; int8_t contador2 = -1; while (1) { // Aumento la velocidad para que la secuencia sea mas lenta if ((bot2 == 0) && (bot3 == 0)) { if (velocidad < 230) { velocidad += 10; } else { velocidad = 230; } } // Disminuyo la velocidad para que la secuencia sea más rapida if ((bot2 == 0) && (bot4 == 0)) { if (velocidad > 50) { velocidad -= 10; } else { velocidad = 50; } } if (contador2 == 15) { contador2 = -1; // reseteo la variable que marca el punto de inicio de la secuencia } if ((bot1 == 0) && (bot1_prev == 1)) { _delay_ms(20); // tiempo general de rebote if (bot1 == 0) { contador = !contador; // Esto hace que cada que entra en esta condición, cambia el estado de "contador" entre 0 y 1, siendo 1 cuando la secuencia está en movimiento y 0 cuando está apagada while (bot1 == 0) ; PORTD &= ~(1 << PD2); PORTD &= ~(1 << PD3); PORTD &= ~(1 << PD4); PORTD &= ~(1 << PD5); PORTD &= ~(1 << PD6); PORTD &= ~(1 << PD7); PORTB &= ~(1 << PB0); PORTB &= ~(1 << PB1); // bloqueo el botón 1 mientras lo siga presionando hasta que suelte el botón } } bot1_prev = bot1; // guardo el estado actual para la próxima vuelta if (contador == 1) { contador2++; for (uint8_t i = 0; i < velocidad; i++) // este for lo que hace es que según el valor de velocidad con los if anteriores, es el delay que se implementa en la secuencia { _delay_ms(1); } switch (contador2) { case 0: PORTD |= (1 << PD2); PORTD &= ~(1 << PD3); PORTD &= ~(1 << PD4); PORTD &= ~(1 << PD5); PORTD &= ~(1 << PD6); PORTD &= ~(1 << PD7); PORTB &= ~(1 << PB0); PORTB &= ~(1 << PB1); break; case 1: PORTD |= (1 << PD3); break; case 2: PORTD &= ~(1 << PD2); PORTD |= (1 << PD4); break; case 3: PORTD &= ~(1 << PD3); PORTD |= (1 << PD5); break; case 4: PORTD &= ~(1 << PD4); PORTD |= (1 << PD6); break; case 5: PORTD &= ~(1 << PD5); PORTD |= (1 << PD7); break; case 6: PORTD &= ~(1 << PD6); PORTB |= (1 << PB0); break; case 7: PORTD &= ~(1 << PD7); PORTB |= (1 << PB1); break; case 8: PORTB |= (1 << PB1); PORTB &= ~(1 << PB0); break; case 9: PORTB |= (1 << PB0); break; case 10: PORTB &= ~(1 << PB1); PORTD |= (1 << PD7); break; case 11: PORTB &= ~(1 << PB0); PORTD |= (1 << PD6); break; case 12: PORTD &= ~(1 << PD7); PORTD |= (1 << PD5); break; case 13: PORTD &= ~(1 << PD6); PORTD |= (1 << PD4); break; case 14: PORTD &= ~(1 << PD5); PORTD |= (1 << PD3); break; case 15: PORTD &= ~(1 << PD4); PORTD |= (1 << PD2); break; default: break; } } } }